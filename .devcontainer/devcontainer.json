{
  "name": "checkerbots",
  "image": "mcr.microsoft.com/devcontainers/go:2-1.26-trixie",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ],
      "settings": {
        "go.useLanguageServer": true,
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true
      }
    }
  },
  "postCreateCommand": "go install github.com/air-verse/air@v1.67.4 && go version && air -v && golangci-lint version",
  "remoteUser": "vscode"
}
